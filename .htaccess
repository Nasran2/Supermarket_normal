<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Block access to internal Laravel files and folders
    RewriteRule ^(?:app|bootstrap|config|database|docs|node_modules|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|README\.md|vite\.config\.js|\.env)$ - [F,L,NC]

    # If /public/ is typed into the URL, redirect to clean URL without /public/
    RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,NE,R=301]

    # Internally forward all clean URLs to public/ folder
    RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
